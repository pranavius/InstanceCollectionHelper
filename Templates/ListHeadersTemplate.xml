<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Frame name="ICHListHeadersTemplate" virtual="true" enableMouse="true" mixin="ICHListHeadersMixin">
        <Size y="25"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="BorderBottom">
                    <Size y="3"/>
                    <Color color="WHITE_FONT_COLOR"/>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" relativePoint="BOTTOMLEFT"/>
                        <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="DiffHeader" inherits="GameTooltipText" justifyH="LEFT" text="Available Difficulty(s)">
                    <Size x="250"/>
                    <!-- Anchored to $parent.InstanceHeader in mixin's OnLoad method -->
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="NameHeader">
                <Size x="180"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="29"/>
                    <Anchor point="BOTTOMLEFT" relativePoint="BOTTOMLEFT" x="29"/>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="Text" inherits="GameTooltipText" justifyH="LEFT">
                            <Anchors>
                                <Anchor point="LEFT"/>
                            </Anchors>
                        </FontString>
                        <Texture parentKey="SortIndicator" atlas="auctionhouse-ui-sortarrow" hidden="true">
                            <Size x="15" y="15"/>
                            <!-- Anchored to $parent.Text in mixin's OnLoad method -->
                        </Texture>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnClick/>
                </Scripts>
            </Button>
            <Button parentKey="InstanceHeader">
                <Size x="225"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.NameHeader" relativePoint="TOPRIGHT" x="25"/>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.NameHeader" relativePoint="BOTTOMRIGHT" x="25"/>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="Text" inherits="GameTooltipText" justifyH="LEFT">
                            <Anchors>
                                <Anchor point="LEFT"/>
                            </Anchors>
                        </FontString>
                        <Texture parentKey="SortIndicator" atlas="auctionhouse-ui-sortarrow" hidden="true">
                            <Size x="15" y="15"/>
                        </Texture>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnClick/>
                </Scripts>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>

    <Frame name="ICHVendorListHeadersTemplate" virtual="true" enableMouse="true" mixin="ICHListHeadersMixin" hidden="true">
        <Size y="25"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="BorderBottom">
                    <Size y="3"/>
                    <Color color="WHITE_FONT_COLOR"/>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" relativePoint="BOTTOMLEFT"/>
                        <Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="NameHeader">
                <Size x="180"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="29"/>
                    <Anchor point="BOTTOMLEFT" relativePoint="BOTTOMLEFT" x="29"/>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="Text" inherits="GameTooltipText" justifyH="LEFT">
                            <Anchors>
                                <Anchor point="LEFT"/>
                            </Anchors>
                        </FontString>
                        <Texture parentKey="SortIndicator" atlas="auctionhouse-ui-sortarrow" hidden="true">
                            <Size x="15" y="15"/>
                        </Texture>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnClick/>
                </Scripts>
            </Button>
            <Button parentKey="TypeHeader">
                <Size x="100"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.NameHeader" relativePoint="TOPRIGHT" x="25"/>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.NameHeader" relativePoint="BOTTOMRIGHT" x="25"/>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="Text" inherits="GameTooltipText" justifyH="LEFT">
                            <Anchors>
                                <Anchor point="LEFT"/>
                            </Anchors>
                        </FontString>
                        <Texture parentKey="SortIndicator" atlas="auctionhouse-ui-sortarrow" hidden="true">
                            <Size x="15" y="15"/>
                        </Texture>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnClick/>
                </Scripts>
            </Button>
            <Button parentKey="ExpansionHeader">
                <Size x="225"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.TypeHeader" relativePoint="TOPRIGHT"/>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.TypeHeader" relativePoint="BOTTOMRIGHT"/>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="Text" inherits="GameTooltipText" justifyH="LEFT">
                            <Anchors>
                                <Anchor point="LEFT"/>
                            </Anchors>
                        </FontString>
                        <Texture parentKey="SortIndicator" atlas="auctionhouse-ui-sortarrow" hidden="true">
                            <Size x="15" y="15"/>
                        </Texture>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnClick/>
                </Scripts>
            </Button>
            <Button parentKey="CostHeader">
                <Size x="100"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.ExpansionHeader" relativePoint="TOPRIGHT"/>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.ExpansionHeader" relativePoint="BOTTOMRIGHT"/>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="Text" inherits="GameTooltipText" justifyH="LEFT">
                            <Anchors>
                                <Anchor point="LEFT"/>
                            </Anchors>
                        </FontString>
                        <Texture parentKey="SortIndicator" atlas="auctionhouse-ui-sortarrow" hidden="true">
                            <Size x="15" y="15"/>
                        </Texture>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnClick/>
                </Scripts>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>
</Ui>
