<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Frame name="ICHInstanceHelper" inherits="VerticalLayoutFrame" parent="UIParent" mixin="ICHInstanceHelperMixin" movable="true" frameStrata="HIGH" registerForDrag="LeftButton" hidden="true">
        <Anchors>
            <Anchor point="TOP" y="-50"/>
        </Anchors>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Bg" setAllPoints="true">
                    <Color color="BLACK_FONT_COLOR" a="0.8"/>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="InstanceName" inherits="GameFontHighlightSmall" text="">
                    <KeyValues>
                        <KeyValue key="layoutIndex" value="1"/>
                    </KeyValues>
                    <Size>
                        <AbsDimension x="240" y="20"/>
                    </Size>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Frame name="ICHInstanceHelperItemContainer" parentKey="ItemContainer" inherits="HorizontalLayoutFrame">
                <KeyValues>
                    <KeyValue key="layoutIndex" value="2"/>
                    <KeyValue key="align" value="center"/>
                </KeyValues>
            </Frame>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnEvent method="OnEvent"/>
            <OnShow method="OnShow"/>
            <OnHide method="OnHide"/>
            <OnDragStart method="OnDragStart"/>
            <OnDragStop method="OnDragStop"/>
        </Scripts>
    </Frame>
</Ui>
