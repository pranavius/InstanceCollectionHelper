<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <Frame name="ICHWorldTour" parent="UIParent" mixin="ICHWorldTourMixin" enableMouse="true" movable="true" frameStrata="DIALOG" registerForDrag="LeftButton" hidden="true">
        <Size x="400" y="325"/>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Bg" setAllPoints="true">
                    <Color color="BLACK_FONT_COLOR"/>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="Title" inherits="GameFontHighlightMedium" text="">
                    <Anchors>
                        <Anchor point="TOPLEFT" y="-10"/>
                        <Anchor point="TOPRIGHT" y="-10"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="ProgressText" inherits="GameFontNormalSmall" text="" justifyH="RIGHT">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="10" y="-10"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="HelpText" inherits="GameFontNormal" text=""/> <!-- Anchored to TypeFilterRow in mixin -->
                <FontString parentKey="InstanceNameText" inherits="GameFontHighlightLarge" text="">
                    <Anchors>
                        <Anchor point="TOP" relativeKey="$parent.HelpText" relativePoint="BOTTOM" x="0" y="-15"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="CloseButton" inherits="UIPanelCloseButtonDefaultAnchors">
                <Size x="20" y="20"/>
                <NormalTexture atlas="common-icon-redx"/>
                <PushedTexture atlas="common-icon-redx"/>
            </Button>
            <Frame parentKey="TypeFilterRow" inherits="HorizontalLayoutFrame">
                <Anchors>
                    <Anchor point="TOP" relativeKey="$parent.Title" relativePoint="BOTTOM" x="10" y="-20"/>
                </Anchors>
                <Frames>
                    <CheckButton parentKey="MountCheckbox" inherits="UICheckButtonTemplate" checked="true" text="">
                        <Size x="20" y="20"/>
                        <KeyValues>
                            <KeyValue key="layoutIndex" value="1"/>
                            <KeyValue key="align" value="center"/>
                        </KeyValues>
                    </CheckButton>
                    <CheckButton parentKey="PetCheckbox" inherits="UICheckButtonTemplate" checked="true" text="">
                        <Size x="20" y="20"/>
                        <KeyValues>
                            <KeyValue key="layoutIndex" value="2"/>
                            <KeyValue key="align" value="center"/>
                        </KeyValues>
                    </CheckButton>
                    <CheckButton parentKey="ToyCheckbox" inherits="UICheckButtonTemplate" checked="true" text="">
                        <Size x="20" y="20"/>
                        <KeyValues>
                            <KeyValue key="layoutIndex" value="3"/>
                            <KeyValue key="align" value="center"/>
                        </KeyValues>
                    </CheckButton>
                    <CheckButton parentKey="DecorCheckbox" inherits="UICheckButtonTemplate" checked="true" text="">
                        <Size x="20" y="20"/>
                        <KeyValues>
                            <KeyValue key="layoutIndex" value="4"/>
                            <KeyValue key="align" value="center"/>
                        </KeyValues>
                    </CheckButton>
                </Frames>
            </Frame>
            <Frame parentKey="ItemContainer" inherits="HorizontalLayoutFrame">
                <Anchors>
                    <Anchor point="TOP" relativeKey="$parent.InstanceNameText" relativePoint="BOTTOM" y="-15"/>
                </Anchors>
            </Frame>
            <Button parentKey="ResetButton">
                <Size x="20" y="20"/>
                <Anchors>
                    <Anchor point="BOTTOM" y="40"/>
                </Anchors>
                <NormalTexture atlas="common-icon-undo"/>
            </Button>
            <Button parentKey="PrevButton">
                <Size x="30" y="30"/>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" x="10" y="10"/>
                </Anchors>
                <NormalTexture atlas="common-icon-backarrow"/>
            </Button>
            <Button parentKey="StartStopButton" inherits="UIPanelButtonTemplate">
                <Size x="100" y="22"/>
                <Anchors>
                    <Anchor point="BOTTOM" y="10"/>
                </Anchors>
            </Button>
            <Button parentKey="NextButton">
                <Size x="30" y="30"/>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT" x="-10" y="10"/>
                </Anchors>
                <NormalTexture atlas="common-icon-forwardarrow"/>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnShow method="OnShow"/>
            <OnDragStart method="OnDragStart"/>
            <OnDragStop method="OnDragStop"/>
        </Scripts>
    </Frame>
</Ui>
